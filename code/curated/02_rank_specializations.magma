// MagmaCell. Reconstructed rank verification from reported values.
// RankBounds may be expensive. An interval [r,r] certifies rank r.
Q := RationalField();
values := [Q|-46/9,-12/11,-17/31,15/8,-7,-4,8,-4/3,-1/3,
             4/3,-7/4,2/5,-5/7,1/9,1/2,1];
for t in values do
    print "================================";
    print "t =",t;
    A := (1-t^2)/(1+t^2);
    B := 2*t/(1+t^2);
    E := EllipticCurve([Q|0,0,0,4*A,-8*B]);
    print "A =",A,"B =",B;
    print "Curve =",E;
    print "Rank bounds =",RankBounds(E);
end for;
